[1968.462367, "o", "\u001b[?25l\u001b(B\u001b[m\u001b[3m\u001b[38;2;99;109;166m\u001b[48;2;47;51;77m-- Cross OS hyprland config.\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;47;51;77m                                                            \u001b[2;8H\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;34;36;54m \u001b[3;8H\u001b(B\u001b[m\u001b[3m\u001b[38;2;99;109;166m\u001b[48;2;34;36;54m-- This is the monitor setup, leaving sstuff on auto should work.\u001b[4;8H\u001b(B\u001b[m\u001b[4:3m\u001b[58:2::255:199:119m\u001b[38;2;200;211;245m\u001b[48;2;34;36;54mhl\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;34;36;54m.\u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;34;36;54mmonitor\u001b(B\u001b[m\u001b[38;2;130;139;184m\u001b[48;2;34;36;54m(\u001b(B\u001b[m\u001b[38;2;192;153;255m\u001b[48;2;34;36;54m{\u001b[5;8H\u001b(B\u001b[m\u001b[38;2;59;66;97m\u001b[48;2;34;36;54m│\u001b[5;9H\u001b(B\u001b[m\u001b[38;2;59;66;97m\u001b[48;2;34;36;54m \u001b(B\u001b[m\u001b[38;2;79;214;190m\u001b[48;2;34;36;54moutput\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;34;36;54m \u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;34;36;54m=\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;34;36;54m \u001b(B\u001b[m\u001b[38;2;195;232;141m\u001b[48;2;34;36;54m\"\"\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;34;36;54m,\u001b[6;8H\u001b(B\u001b[m\u001b[38;2;59;66;97m\u001b[48;2;34;36;54m│\u001b[6;9H\u001b(B\u001b[m\u001b[38;2;59;66;97m\u001b[48;2;34;36;54m \u001b(B\u001b[m\u001b[38;2;79;214;190m\u001b[48;2;34;36;54mmode\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;34;36;54m \u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;34;36;54m=\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;34;36;54m \u001b(B\u001b[m\u001b[38;2;195;232;141m\u001b[48;2;34;36;54m\"preferred\"\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;34;36;54m,\u001b[7;8H\u001b(B\u001b[m\u001b[38;2;59;66;97m\u001b[48;2;34;36;54m│\u001b[7;9H\u001b(B\u001b[m\u001b[38;2;59;66;97m\u001b