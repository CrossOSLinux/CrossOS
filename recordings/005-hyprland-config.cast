[487.932605, "o", "\u001b[?25l\u001b[4;42H\u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b(B\u001b[m\u001b[38;2;192;153;255m\u001b[48;2;30;32;48mfunction\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m \u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;30;32;48mload\u001b(B\u001b[m\u001b[38;2;130;139;184m\u001b[48;2;30;32;48m(\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mchunk\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m:\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m \u001b(B\u001b[m\u001b[38;2;255;117;127m\u001b[48;2;30;32;48mstring\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m|function\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m,\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m \u001b(B\u001b[m\u001b[38;2;255;199;119m\u001b[48;2;30;32;48mchunkname?\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m:\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m   \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[5;42H \u001b(B\u001b[m\u001b[38;2;255;117;127m\u001b[48;2;30;32;48mstring\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m,\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m \u001b(B\u001b[m\u001b[38;2;255;199;119m\u001b[48;2;30;32;48mmode?\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m:\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m \"b\"|\"bt\"|\"t\"\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m,\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m env?\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m:\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m \u001b(B\u001b[m\u001b[38;2;255;117;127m\u001b[48;2;30;32;48mtable\u001b(B\u001b[m\u001b[38;2;130;139;184m\u001b[48;2;30;32;48m)\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m           \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[6;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m  -> function?                                      \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[7;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m  \u001b(B\u001b[m\u001b[38;2;255;150;108m\u001b[48;2;30;32;48m2.\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m error_message\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m:\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m string?                         \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[8;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m─\u001b[8;44H─\u001b[8;45H─\u001b[8;46H─\u001b[8;47H─\u001b[8;48H─\u001b[8;49H─\u001b[8;50H─\u001b[8;51H─\u001b[8;52H─\u001b[8;53H─\u001b[8;54H─\u001b[8;55H─\u001b[8;56H─\u001b[8;57H─\u001b[8;58H─\u001b[8;59H─\u001b[8;60H─\u001b[8;61H─\u001b[8;62H─\u001b[8"]
[487.933479, "o", ";63H─\u001b[8;64H─\u001b[8;65H─\u001b[8;66H─\u001b[8;67H─\u001b[8;68H─\u001b[8;69H─\u001b[8;70H─\u001b[8;71H─\u001b[8;72H─\u001b[8;73H─\u001b[8;74H─\u001b[8;75H─\u001b[8;76H─\u001b[8;77H─\u001b[8;78H─\u001b[8;79H─\u001b[8;80H─\u001b[8;81H─\u001b[8;82H─\u001b[8;83H─\u001b[8;84H─\u001b[8;85H─\u001b[8;86H─\u001b[8;87H─\u001b[8;88H─\u001b[8;89H─\u001b[8;90H─\u001b[8;91H─\u001b[8;92H─\u001b[8;93H─\u001b[8;94H─\u001b[8;95H\u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[9;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mLoads a chunk.                                      \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[10;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mIf \u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;68;74;115mchunk\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m is a string, the chunk is this string.     \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[11;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mIf \u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;68;74;115mchunk\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m is a function, \u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;68;74;115mload\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m calls it               \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[12;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mrepeatedly to get the chunk pieces. Each call to    \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[13;42H \u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;68;74;115mchunk\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m must return a string that concatenates with   \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[14;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mprevious results. A return of an empty string,      \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[15;42H \u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;68;74;115mnil\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m, or no value signals the end of the chunk.      \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[16;42H \u001b(B\u001b[m\u001b[38;2;101;188;255m\u001b[48;2;30;32;48mView documents\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m                                      \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[17;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m                                                    \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[18;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m                                                    \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[19;42H \u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48mmode\u001b(B\u001b[m\u001b[38;2;137;221;255m\u001b[48;2;30;32;48m:\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m                                               \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[20;42H \u001b(B\u001b[m\u001b[38;2;195;232;141m\u001b[48;2;30;32;48m    | \"\u001b(B\u001b[m\u001b[38;2;130;170;255m\u001b[48;2;30;32;48mb\u001b(B\u001b[m\u001b[38;2;195;232;141m\u001b[48;2;30;32;48m\" -- Only binary chunks.\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;30;32;48m                    \u001b(B\u001b[m\u001b[38;2;88;158;215m\u001b[48;2;30;32;48m \u001b[4;95H\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;39;41;58m \u001b[5;95H \u001b[6;95H \u001b[7;95H \u001b[8;95H \u001b[9;95H \u001b[10;95H \u001b[11;95H \u001b[12;95H \u001b[13;95H \u001b[14;95H \u001b[15;95H \u001b[16;95H \u001b[17;95H \u001b[18;95H \u001b[19;95H \u001b[20;95H \u001b[4;95H\u001b(B\u001b[m\u001b[38;2;200;211;245m\u001b[48;2;59;66;97m \u001b[5;95H \u00