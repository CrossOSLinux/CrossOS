[3135.440059, "o", "]8;;\u001b\\+# Cross OS - Config Installer\u001b(B\u001b[m\u001b]8;;\u001b\\                               │\u001b[10;1H\u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b]8;;\u001b\\  \u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\▼\u001b(B\u001b[m\u001b]8;;\u001b\\ \u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\scripts\u001b(B\u001b[m\u001b]8;;\u001b\\                   \u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\▐\u001b(B\u001b[m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+set -e\u001b(B\u001b[m\u001b]8;;\u001b\\                                                      │\u001b[11;1H\u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b[44m\u001b[1m\u001b]8;;\u001b\\    \u001b(B\u001b[m\u001b[92;44m\u001b[1m\u001b]8;;\u001b\\A  configs.sh\u001b(B\u001b[m\u001b[44m\u001b[1m\u001b]8;;\u001b\\             \u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\▐\u001b(B\u001b[m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+\u001b(B\u001b[m\u001b]8;;\u001b\\                                                            │\u001b[12;1H\u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b]8;;\u001b\\    \u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\M  install.sh\u001b(B\u001b[m\u001b]8;;\u001b\\             \u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\▐\u001b(B\u001b[m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+CROSSOS_DIR=\"$(cd \"$(dirname \"$0\")/..\" && pwd)\"\u001b(B\u001b[m\u001b]8;;\u001b\\             │\u001b[13;1H\u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b]8;;\u001b\\    \u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\A  packages.sh            \u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\▐\u001b(B\u001b[m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+CONFIGS=\"$CROSSOS_DIR/configs\"\u001b(B\u001b[m\u001b]8;;\u001b\\                              │\u001b[14;1H\u001b(B\u001b[m\u001b[32m\u001b[1m\u001b]8;;\u001b\\╰─────────────────────10 of 12─╯\u001b(B\u001b[m\u001b]8;;\u001b\\│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+\u001b(B\u001b[m\u001b]8;;\u001b\\                                                            │\u001b[15;1H╭─[3]─\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\Local branches \u001b(B\u001b[m\u001b]8;;\u001b\\- Remotes─╮│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+echo \"--- Installing configs ---\"\u001b(B\u001b[m\u001b]8;;\u001b\\                           │\u001b[16;1H│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\  *\u001b(B\u001b[m\u001b]8;;\u001b\\ main \u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\✓                    \u001b(B\u001b[m\u001b]8;;\u001b\\││\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+\u001b(B\u001b[m\u001b]8;;\u001b\\                                                            │\u001b[17;1H╰───────────────────────1 of 1─╯│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+# Hyprland\u001b(B\u001b[m\u001b]8;;\u001b\\                                                  │\u001b[18;1H╭─[4]─\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\Commits \u001b(B\u001b[m\u001b]8;;\u001b\\- Reflog─────────╮│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+mkdir -p ~/.config/hypr\u001b(B\u001b[m\u001b]8;;\u001b\\                                     │\u001b[19;1H│\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\9d744659\u001b(B\u001b[m\u001b]8;;\u001b\\ \u001b(B\u001b[m\u001b[38;2;213;118;65m\u001b]8;;\u001b\\Va\u001b(B\u001b[m\u001b]8;;\u001b\\ \u001b(B\u001b[m\u001b[38;2;213;118;65m\u001b]8;;\u001b\\◯\u001b(B\u001b[m\u001b]8;;\u001b\\ Fixed minor bugs││\u001b(B\u001b[m\u001b[32m\u001b]8;;\u001b\\+cp \"$CONFIGS/hyprland/hyprland.lua\"                         \u001b(B\u001b[m\u001b]8;;\u001b\\│\u001b[20;1H╰───────────────────────1 of 4─╯╰─────────────────────────────────────────────────────────────╯\u001b[21;1H╭─[5]─Stash────────────────────╮╭─Command log─────────────────────────────────────────────────╮\u001b[22;1H│                      